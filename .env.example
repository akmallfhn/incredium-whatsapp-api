# Port. Railway
APP_PORT="8000"

# Postgre SQL
DATABASE_URL=""

# Meta WhatsApp Cloud API
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""

# Supabase Storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET=""

# LLM. Provider utama: "openai" atau "deepseek". Kosong = openai.
LLM_PROVIDER="openai"

# DeepSeek sudah tersambung penuh tapi belum dipakai; isi key-nya lalu ganti
# LLM_PROVIDER jadi "deepseek" kalau mau dijadikan jalur utama.
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""

# Fallback dipakai otomatis kalau provider utama habis kuota. Kosongkan untuk mematikannya.
ANTHROPIC_API_KEY=""
ANTHROPIC_FALLBACK_MODEL="claude-haiku-4-5-20251001"

# Bearer token untuk endpoint /api/v1/stats (dipakai client dashboard)
CLIENT_SECRET=""
STAT_TIMEZONE="Asia/Jakarta"

DEBUG=false
